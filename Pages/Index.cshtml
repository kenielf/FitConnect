@page
@model IndexModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - FitConnect Gym</title>
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <div class="background-container">
        <img src="~/images/TelaInicial.png" class="bg-image" alt="Background">
    </div>

    <!-- Logo -->
    <div class="logo-container">
        <img src="~/images/FitConnectLogo.png" class="logo" alt="FitConnect Logo">

        <button class="login-button" onclick="window.location.href='/AdminLogin';"
                style="padding: 20px 50px; background-color: #ffffff; color: #576D82; border: none; border-radius: px; font-weight: bolder; cursor: pointer; font-size: 20px; text-transform: uppercase; box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);">
            LOGIN
        </button>


        <p id="moveText" style="position: absolute; top: 500px; left: 15px; font-size: 16px; color: white; text-align: center;">
            ainda não tem uma conta?
            <a href="/AdminRegister" style="color: white !important; font-weight: bold; text-decoration: none; cursor: pointer; transition: font-weight 0.2s ease, transform 0.2s ease;"
               onmouseover="this.style.fontWeight='900'; this.style.textDecoration='underline'; this.style.transform='scale(1.1)';"
               onmouseout="this.style.fontWeight='bold'; this.style.textDecoration='none'; this.style.transform='scale(1)';">
                crie agora!
            </a>
        </p>
    </div>
</body>
</html>
